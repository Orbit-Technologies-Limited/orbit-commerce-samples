# Every variable this plugin reads. Orbit hosting sets all five for you.
# npm run dev, npm test and npm run build copy this file to .env when there is none (git ignores .env).
# Put secrets in .env.local, never here: this file is committed.

# The plugin's own database: .env points it at a SQLite file on your computer, and Orbit hosting sets its Postgres database.
DATABASE_URL="file:./dev.db"

# The Orbit API to call: .env sets the live API, orbit-plugin dev sets the one you signed in to, and Orbit hosting sets it for you.
ORBIT_API_URL=https://api.myorbitcommerce.net

# Proves a webhook or connect call came from Orbit: orbit-plugin dev writes it to .env.local, and Orbit hosting sets it for you.
WEBHOOK_SECRET=

# Encrypts each store's tokens at rest (64 hex characters): orbit-plugin create writes one to .env.local, and Orbit hosting sets it for you.
TOKEN_ENCRYPTION_KEY=

# The plugin's public address, for absolute links: orbit-plugin dev sets it to the secure link it opens, and Orbit hosting sets it to your Orbit address.
PLUGIN_PUBLIC_URL=
